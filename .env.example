# Copy this file to .env and fill in your API keys.
#
# At runtime the app loads .env from the config directory:
#   macOS:   ~/Library/Application Support/com.promptheus.desktop/.env
#   Linux:   ~/.config/com.promptheus.desktop/.env
#
# A .env in the working directory or any parent (in development the project
# root, promptheus-tauri/) is loaded afterwards and overrides the config
# directory one.

OPENAI_API_KEY=your_api_key_here
