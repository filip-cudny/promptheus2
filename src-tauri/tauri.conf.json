{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "Promptheus",
  "version": "0.1.0",
  "identifier": "com.promptheus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": ["wl-clipboard"],
        "files": {
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/metadata.json": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/metadata.json",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/extension.js": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/extension.js",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/success-mono.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/success-mono.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/success-color.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/success-color.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/error-mono.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/error-mono.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/error-color.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/error-color.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/info-mono.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/info-mono.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/info-color.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/info-color.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/warning-mono.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/warning-mono.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/warning-color.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/warning-color.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/recording-pause.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/recording-pause.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/recording-play.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/recording-play.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/recording-stop.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/recording-stop.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/recording-cancel.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/recording-cancel.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/recording-check.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/recording-check.svg",
          "/usr/share/gnome-shell/extensions/promptheus@promptheus.desktop/icons/recording-loader.svg": "../linux/gnome-shell-extension/promptheus@promptheus.desktop/icons/recording-loader.svg"
        }
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/default_settings.json"
    ]
  },
  "plugins": {}
}
